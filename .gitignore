# Your AWS / API credentials — copy .env.example to .env and fill it in. Never commit .env.
.env
# Deploy-only AWS keys, for lessons that deploy to AWS — kept apart from .env. Never commit.
.env.deploy

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Virtualenv
.venv/
venv/

# Local vector/index/database artifacts
chroma_db/
qdrant_storage/
*.faiss
faiss_index*/
data/index/
data/cache/
# Runtime state: databases, workflow scratch dirs, logs, outboxes
data/
*.db
*.sqlite
*.sqlite3

# IDE / OS — but NOT .vscode/settings.json: each lesson ships one so walkthroughs
# open in rendered markdown preview.
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
