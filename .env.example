# AWS credentials are loaded through the standard AWS credential chain.
AWS_REGION=us-east-1

# Bedrock models
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Langfuse tracing (leave blank to disable remote tracing locally)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# NovaOps paths and deterministic evaluation clock
NOVAOPS_DATA_DIR=novaops-enterprise-agent-dataset
NOVAOPS_DATABASE_PATH=data/novaops.sqlite3
NOVAOPS_CHECKPOINT_PATH=data/checkpoints.sqlite3
NOVAOPS_INDEX_PATH=data/index
NOVAOPS_MCP_URL=http://127.0.0.1:9876/mcp
NOVAOPS_AS_OF_DATE=2026-07-01

# Retrieval chunking defaults; use measured alternatives only via explicit configuration.
NOVAOPS_CHUNK_WORDS=320
NOVAOPS_OVERLAP_WORDS=80
